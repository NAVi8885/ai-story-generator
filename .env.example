# Mythos Studio — Environment Configuration
# Zero-Cost Setup: You can run the app immediately with NO API keys configured.
# The backend automatically falls back to the built-in zero-auth engine.

PORT=3001
FRONTEND_URL=http://localhost:5173

# Optional Free-Tier Cloud Providers (zero-card, free sign-up):
# 1. Groq (High-speed Qwen 3.8 27B / Allam 2 7B): https://console.groq.com/
# GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Google Gemini Flash (Free tier via Google AI Studio): https://aistudio.google.com/
# GEMINI_API_KEY=AIzaSy_your_gemini_key_here

# 3. OpenRouter Free Tier (:free open-weight models): https://openrouter.ai/
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# 4. Hugging Face Inference Router: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=hf_your_token_here
# HF_MODEL=Qwen/Qwen2.5-72B-Instruct
